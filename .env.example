# Copy this file to .env for local dev, and set the same keys as
# Environment Variables in your Vercel project settings for production.

# In local dev you can leave this unset — vite.config.js proxies /api
# to http://localhost:5000 automatically. In production you MUST set
# this to your deployed backend URL (Render/Railway), e.g.:
# VITE_API_URL=https://asumbi-backend.onrender.com/api
VITE_API_URL=

# Same idea for the Socket.io connection, e.g.:
# VITE_SOCKET_URL=https://asumbi-backend.onrender.com
VITE_SOCKET_URL=
